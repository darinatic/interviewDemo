# One key. Every model role is routed through OpenRouter so the judge panel can span
# several model families without several accounts.
OPENROUTER_API_KEY=

# Optional per-role overrides. Any role can be pointed at a different model without
# touching code - see conveval/llm.py.
# CONVEVAL_SUT=openai/gpt-4o-mini
# CONVEVAL_LEARNER=mistralai/mistral-small-3.2-24b-instruct
# CONVEVAL_ORCHESTRATOR=anthropic/claude-haiku-4.5
# CONVEVAL_JUDGE_1=anthropic/claude-sonnet-4.5
# CONVEVAL_JUDGE_2=google/gemini-2.5-flash
# CONVEVAL_JUDGE_3=meta-llama/llama-3.3-70b-instruct

# Hard ceiling on extra model calls the orchestrator may spend per suite.
# CONVEVAL_EXTRA_CALL_BUDGET=80
